TMDB_API_KEY=your_tmdb_api_key
# Не отключайте TLS-проверку; укажите CA bundle только если PHP не видит его сам.
TMDB_CAINFO=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gexusfilm
DB_USERNAME=gexusfilm
DB_PASSWORD=gexusfilm-local-password

CACHE_TTL_MINUTES=1440
RATE_LIMIT_DEFAULT=120
RATE_LIMIT_SEARCH=60
RATE_LIMIT_WINDOW_SECONDS=60

TMDB_REQUESTS_PER_SECOND=10
TMDB_MAX_CONCURRENT=10
TMDB_QUEUE_TIMEOUT_MS=250
TMDB_SINGLEFLIGHT_TIMEOUT_MS=2000
TMDB_SINGLEFLIGHT_RESULT_TTL_SECONDS=15
TMDB_CIRCUIT_FAILURE_THRESHOLD=5
TMDB_CIRCUIT_COOLDOWN_SECONDS=30
TMDB_COORDINATION_DIR=
