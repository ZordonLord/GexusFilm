{
    "name": "zordon/gexusfilm-backend",
    "type": "project",
    "description": "GexusFilm backend API",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "7.15.2",
        "http-interop/http-factory-guzzle": "1.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "squizlabs/php_codesniffer": "3.13.6"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "lint-fix": "phpcbf"
    },
    "config": {
        "sort-packages": true,
        "optimize-autoloader": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
